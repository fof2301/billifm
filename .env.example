# Billi FM - required environment. Copy to .env (git-ignored) and fill.

# ============================================================
# Story framework (apps/server + apps/web, `pnpm dev`)
# ============================================================
OPENAI_API_KEY=
DIALOGUE_MODEL=gpt-4o-mini
STT_MODEL=whisper-1
TTS_MODEL=gpt-4o-mini-tts
PORT=8787
# STORIES_DIR=/absolute/path/to/stories  # optional; defaults to <repo>/stories
# DB_PATH=/absolute/path/to/sessions.db  # optional; defaults to <repo>/data/sessions.db
# ELEVENLABS_API_KEY=   # for scripts/generate-audio.mjs and (later) the ElevenLabs TTS provider

# ============================================================
# Sutradhar player stack (server/ + app/, see files/ docs)
# Voice stack per memory.md D12: OpenAI Realtime for live conversations,
# ElevenLabs for everything pre-generated, Twilio as the PSTN transport only.
# ============================================================

# --- Live conversations (villain call, heroine callback) ---
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=cedar

# --- Pre-generated audio (narration, branches, voice notes) ---
ELEVENLABS_API_KEY=
MEERA_VOICE_ID=
VILLAIN_VOICE_ID=
NARRATOR_VOICE_ID=

# --- Telephony: M6 outbound callback + voice-note SMS (P1, first to cut) ---
TWILIO_SID=
TWILIO_AUTH=
TWILIO_FROM=
DEMO_PHONE_NUMBER=

# --- Server ---
SERVER_BASE_URL=http://localhost:8000
LISTENER_ID=demo

# --- M7 Databricks batch run + genome pipeline (see eval/) ---
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
